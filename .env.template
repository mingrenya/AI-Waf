# AI-Waf 生产环境配置模板
# 说明：复制为 .env 后，按生产环境实际值填写

# ===== MongoDB配置 =====
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_INITDB_DATABASE=waf_db

# ===== JWT配置 =====
JWT_SECRET=CHANGE_ME_64_PLUS_CHAR_SECRET
JWT_EXPIRATION_HRS=12

# ===== MCP Server配置 =====
# MCP 容器自动登录凭据（无需手动维护 Token）
WAF_USERNAME=admin
WAF_PASSWORD=admin@123

# ===== 运行模式 =====
IS_PRODUCTION=true

# ===== 跨域与前端地址 =====
# 已配置域名 + 本地调试地址
CORS_ALLOWED_ORIGINS=https://aiwaf.com,http://localhost:2333,http://127.0.0.1:2333,http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=https://aiwaf.com/api/v1

# ===== 日志配置 =====
LOG_LEVEL=warn
LOG_FORMAT=json

# ===== DeepSeek AI助手配置（可选） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Redis 配置
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
