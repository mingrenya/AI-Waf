# AI-Waf 配置模板
# 说明：复制为 .env 后，按实际环境填写

# ===== 运行模式 =====
IS_PRODUCTION=false
IS_K8S=false

# ===== 服务绑定 =====
# BIND 格式: IP:端口，默认 0.0.0.0:2333
# BIND=0.0.0.0:2333

# ===== 前端配置 =====
# 开发模式无需设置（Vite dev server 自带 proxy 到 localhost:2333）
# 生产模式必须设置为前端可访问的 API 地址
VITE_API_BASE_URL=https://aiwaf.com/api/v1
VITE_API_TIMEOUT=10000

# ===== MongoDB 配置 =====
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_INITDB_DATABASE=waf_db
DB_URI=mongodb://root:CHANGE_ME_STRONG_PASSWORD@mongodb:27017
DB_NAME=waf

# ===== JWT 配置 =====
JWT_SECRET=CHANGE_ME_64_PLUS_CHAR_SECRET
JWT_EXPIRATION_HRS=12

# ===== 跨域 =====
# 多个来源用英文逗号分隔，需包含前端地址和本地调试端口
CORS_ALLOWED_ORIGINS=https://aiwaf.com,http://localhost:2333,http://127.0.0.1:2333,http://localhost:5173,http://127.0.0.1:5173

# ===== MCP Server 配置 =====
WAF_USERNAME=admin
WAF_PASSWORD=CHANGE_ME_MCP_PASSWORD

# ===== Redis 配置 =====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# ===== 日志系统配置 =====
LOG_LEVEL=info          # debug | info | warn | error
LOG_FILE=/dev/stdout    # 日志文件路径
LOG_FORMAT=console      # console | json（生产建议 json）
# Loki 日志聚合地址, Docker 环境默认 http://loki:3100
# LOKI_URL=http://loki:3100

# ===== 数据目录（可选，留空自动探测） =====
# NUCLEI_TEMPLATES_PATH=./nuclei-templates
# CAPTURE_DATA_PATH=./data/captures
# BACKUP_DATA_PATH=./data/backups
# FTW_TESTS_PATH=./server/public/ftw-tests

# ===== K8s 专有配置（IS_K8S=true 时生效） =====
# GEOIP_BASE_PATH=/opt/geoip
# HAPROXY_BASE_PATH=/opt/waf

# ===== DeepSeek AI 助手配置（可选） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 高级选项 =====
# DISABLE_WEB=true         # 禁用前端静态资源托管
# WEB_PATH=/app/web/dist   # 自定义前端构建产物路径
# FORCE_RESET_CONFIG=true  # 启动时强制重置数据库配置为默认值（谨慎使用）

# ===== WAF 高级防护（可选） =====
# SENSITIVE_DATA_FILTER=true  # 开启响应体敏感数据脱敏（身份证/手机号/银行卡号）
# SCAN_PROTECTION=true        # 开启扫描防护（高频扫描封禁 + 扫描器指纹拦截）
# BOT_PROTECTION=true         # 开启 Bot 检测（UA指纹 + 行为频率、分类拦截）
# FORENSICS_CAPTURE=true      # 开启取证式自动流量捕获（攻击事件触发自动抓包）

# ===== Grafana（可选） =====
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
