# AI-Waf MCP Server Dockerfile
# 使用官方go-sdk实现标准MCP协议
ARG DOCKER_REGISTRY=docker.io
FROM ${DOCKER_REGISTRY}/library/golang:1.24.1-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /build

# 复制mcp-server模块
COPY mcp-server/go.mod mcp-server/go.sum ./
RUN go mod download

# 复制源代码（包括 cmd/ 目录和 middleware.go）
COPY mcp-server/ ./

# 编译主程序（stdio版本）
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-w -s" -o ai-waf-mcp .

# 可选：同时编译HTTP版本用于监控
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-w -s" -o server-http ./cmd/server-http

# 运行阶段
FROM ${DOCKER_REGISTRY}/library/alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

# 复制编译好的二进制文件
COPY --from=builder /build/ai-waf-mcp .
COPY --from=builder /build/server-http .

# 环境变量应该在 docker-compose.yaml 或运行时设置
# WAF_BACKEND_URL: 后端 API 地址
# WAF_API_TOKEN: 后端 API 认证令牌（敏感信息，不要硬编码）

# 默认运行stdio版本（可通过docker-compose.yaml覆盖启动HTTP版本）
CMD ["./ai-waf-mcp"]
