// tools/ai_analysis_advanced.go
// 高级AI分析工具 - 攻击模式识别和规则生成
package tools

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// AnalyzeAttackPatternsInput 分析攻击模式的输入参数
type AnalyzeAttackPatternsInput struct {
	TimeRange        string  `json:"timeRange" jsonschema:"Time range (1h, 6h, 24h, or 7d)"`
	MinSamples       int     `json:"minSamples,omitempty" jsonschema:"Minimum sample count"`
	AnomalyThreshold float64 `json:"anomalyThreshold,omitempty" jsonschema:"Anomaly detection threshold"`
	ClusteringMethod string  `json:"clusteringMethod,omitempty" jsonschema:"Clustering method (kmeans or dbscan)"`
}

// AnalyzeAttackPatternsOutput 攻击模式分析输出
type AnalyzeAttackPatternsOutput struct {
	DetectedPatterns   []DetectedPattern `json:"detectedPatterns" jsonschema:"Detected attack patterns"`
	TotalSamples       int               `json:"totalSamples" jsonschema:"Total analyzed samples"`
	PatternCount       int               `json:"patternCount" jsonschema:"Number of identified patterns"`
	HighSeverityCount  int               `json:"highSeverityCount" jsonschema:"Number of high severity patterns"`
	AutoGeneratedRules int               `json:"autoGeneratedRules" jsonschema:"Number of auto-generated rules"`
	AnalysisMetrics    AnalysisMetrics   `json:"analysisMetrics" jsonschema:"Analysis metrics"`
}

// DetectedPattern 检测到的攻击模式
type DetectedPattern struct {
	ID              string                 `json:"id" jsonschema:"Pattern ID"`
	Name            string                 `json:"name" jsonschema:"Pattern name"`
	PatternType     string                 `json:"patternType" jsonschema:"Pattern type (sql_injection, xss, path_traversal, etc)"`
	Confidence      float64                `json:"confidence" jsonschema:"Confidence level (0.0-1.0)"`
	Severity        string                 `json:"severity" jsonschema:"Severity level (low, medium, high, or critical)"`
	SampleCount     int                    `json:"sampleCount" jsonschema:"Number of samples"`
	Frequency       float64                `json:"frequency" jsonschema:"Frequency per hour"`
	Characteristics PatternCharacteristics `json:"characteristics" jsonschema:"Pattern characteristics"`
	Recommendation  string                 `json:"recommendation" jsonschema:"Protection recommendations"`
}

// PatternCharacteristics 模式特征
type PatternCharacteristics struct {
	CommonURLs        []string `json:"commonUrls" jsonschema:"Common attack URLs"`
	CommonPaths       []string `json:"commonPaths" jsonschema:"Common attack paths"`
	SourceIPCountries []string `json:"sourceIpCountries" jsonschema:"Attack source countries"`
	PayloadPatterns   []string `json:"payloadPatterns" jsonschema:"Payload patterns"`
	UserAgents        []string `json:"userAgents" jsonschema:"User-Agent characteristics"`
}

// AnalysisMetrics 分析指标
type AnalysisMetrics struct {
	ProcessingTime   float64 `json:"processingTime" jsonschema:"Processing time in seconds"`
	ClusteringScore  float64 `json:"clusteringScore" jsonschema:"Clustering quality score"`
	AnomalyScore     float64 `json:"anomalyScore" jsonschema:"Anomaly detection score"`
	AccuracyEstimate float64 `json:"accuryEstimate" jsonschema:"Accuracy estimate"`
}

// CreateAnalyzeAttackPatterns 创建分析攻击模式的工具函数
func CreateAnalyzeAttackPatterns(client *APIClient) func(context.Context, *mcp.CallToolRequest, AnalyzeAttackPatternsInput) (*mcp.CallToolResult, AnalyzeAttackPatternsOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input AnalyzeAttackPatternsInput) (*mcp.CallToolResult, AnalyzeAttackPatternsOutput, error) {
		logger := NewToolLogger("analyze_attack_patterns")
		logger.LogInput(input)

		if input.TimeRange == "" {
			input.TimeRange = "24h"
		}
		if input.MinSamples == 0 {
			input.MinSamples = 10
		}
		if input.AnomalyThreshold == 0 {
			input.AnomalyThreshold = 2.0
		}
		if input.ClusteringMethod == "" {
			input.ClusteringMethod = "kmeans"
		}

		// 调用后端AI分析API
		requestData := map[string]interface{}{
			"timeRange":         input.TimeRange,
			"minSamples":        input.MinSamples,
			"anomalyThreshold":  input.AnomalyThreshold,
			"clusteringMethod":  input.ClusteringMethod,
			"enableAutoRuleGen": true, // 启用自动规则生成
		}

		data, err := client.Post("/api/v1/ai-analyzer/analyze/patterns", requestData)
		if err != nil {
			logger.LogError(err)
			return nil, AnalyzeAttackPatternsOutput{}, WrapError(err, "分析攻击模式")
		}

		var result struct {
			Data AnalyzeAttackPatternsOutput `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, AnalyzeAttackPatternsOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("识别到%d个攻击模式，自动生成%d条规则",
			result.Data.PatternCount, result.Data.AutoGeneratedRules))
		return nil, result.Data, nil
	}
}

// GenerateRuleFromPatternInput 从模式生成规则的输入参数
type GenerateRuleFromPatternInput struct {
	PatternID        string `json:"patternId" jsonschema:"Attack pattern ID"`
	RuleType         string `json:"ruleType" jsonschema:"Rule type (micro_rule or modsecurity)"`
	Action           string `json:"action" jsonschema:"Rule action (block or log)"`
	Priority         int    `json:"priority,omitempty" jsonschema:"Priority level"`
	EnableAutoReview bool   `json:"enableAutoReview,omitempty" jsonschema:"Enable automatic review"`
}

// GenerateRuleFromPatternOutput 生成规则输出
type GenerateRuleFromPatternOutput struct {
	RuleID          string             `json:"ruleId" jsonschema:"Generated rule ID"`
	RuleName        string             `json:"ruleName" jsonschema:"Rule name"`
	RuleType        string             `json:"ruleType" jsonschema:"Rule type"`
	RuleContent     interface{}        `json:"ruleContent" jsonschema:"Rule content"`
	Confidence      float64            `json:"confidence" jsonschema:"Rule confidence level (0.0-1.0)"`
	Status          string             `json:"status" jsonschema:"Rule status (pending, approved, or deployed)"`
	AutoReviewed    bool               `json:"autoReviewed" jsonschema:"Whether auto-reviewed"`
	ReviewResult    string             `json:"reviewResult,omitempty" jsonschema:"Review result"`
	DeploymentReady bool               `json:"deploymentReady" jsonschema:"Whether ready for deployment"`
	Recommendation  RuleRecommendation `json:"recommendation" jsonschema:"Rule recommendations"`
}

// RuleRecommendation 规则建议
type RuleRecommendation struct {
	ShouldDeploy      bool   `json:"shouldDeploy" jsonschema:"Whether deployment is recommended"`
	Reason            string `json:"reason" jsonschema:"Recommendation reason"`
	PotentialImpact   string `json:"potentialImpact" jsonschema:"Potential impact"`
	TestingSuggestion string `json:"testingSuggestion" jsonschema:"Testing suggestions"`
	RollbackPlan      string `json:"rollbackPlan" jsonschema:"Rollback plan"`
}

// CreateGenerateRuleFromPattern 创建从模式生成规则的工具函数
func CreateGenerateRuleFromPattern(client *APIClient) func(context.Context, *mcp.CallToolRequest, GenerateRuleFromPatternInput) (*mcp.CallToolResult, GenerateRuleFromPatternOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input GenerateRuleFromPatternInput) (*mcp.CallToolResult, GenerateRuleFromPatternOutput, error) {
		logger := NewToolLogger("generate_rule_from_pattern")
		logger.LogInput(input)

		if input.RuleType == "" {
			input.RuleType = "micro_rule"
		}
		if input.Action == "" {
			input.Action = "block"
		}
		if input.Priority == 0 {
			input.Priority = 100
		}

		requestData := map[string]interface{}{
			"patternId":        input.PatternID,
			"ruleType":         input.RuleType,
			"action":           input.Action,
			"priority":         input.Priority,
			"enableAutoReview": input.EnableAutoReview,
		}

		data, err := client.Post("/api/v1/ai-analyzer/generate/rule", requestData)
		if err != nil {
			logger.LogError(err)
			return nil, GenerateRuleFromPatternOutput{}, WrapError(err, "生成规则")
		}

		var result struct {
			Data GenerateRuleFromPatternOutput `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, GenerateRuleFromPatternOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("生成规则成功：%s，状态：%s", result.Data.RuleName, result.Data.Status))
		return nil, result.Data, nil
	}
}

// EvaluateRuleEffectivenessInput 评估规则效果的输入参数
type EvaluateRuleEffectivenessInput struct {
	RuleID    string `json:"ruleID" jsonschema:"Rule ID"`
	TimeRange string `json:"timeRange,omitempty" jsonschema:"Evaluation time range (1h, 6h, 24h, or 7d)"`
}

// EvaluateRuleEffectivenessOutput 规则效果评估输出
type EvaluateRuleEffectivenessOutput struct {
	RuleID               string             `json:"ruleId" jsonschema:"Rule ID"`
	RuleName             string             `json:"ruleName" jsonschema:"Rule name"`
	EvaluationPeriod     string             `json:"evaluationPeriod" jsonschema:"Evaluation period"`
	EffectivenessScore   float64            `json:"effectivenessScore" jsonschema:"Effectiveness score (0-100)"`
	PerformanceMetrics   PerformanceMetrics `json:"performanceMetrics" jsonschema:"Performance metrics"`
	SecurityImpact       SecurityImpact     `json:"securityImpact" jsonschema:"Security impact"`
	FalsePositiveRate    float64            `json:"falsePositiveRate" jsonschema:"False positive rate percentage"`
	TruePositiveRate     float64            `json:"truePositiveRate" jsonschema:"True positive rate percentage"`
	Recommendation       string             `json:"recommendation" jsonschema:"Optimization recommendations"`
	AdjustmentSuggestion RuleAdjustment     `json:"adjustmentSuggestion" jsonschema:"Adjustment suggestions"`
}

// PerformanceMetrics 性能指标
type PerformanceMetrics struct {
	TotalMatches     int     `json:"totalMatches" jsonschema:"Total match count"`
	BlockedRequests  int     `json:"blockedRequests" jsonschema:"Number of blocked requests"`
	LoggedRequests   int     `json:"loggedRequests" jsonschema:"Number of logged requests"`
	AverageMatchTime float64 `json:"averageMatchTime" jsonschema:"Average match time in milliseconds"`
	CPUUsage         float64 `json:"cpuUsage" jsonschema:"CPU usage percentage"`
	MemoryUsage      float64 `json:"memoryUsage" jsonschema:"Memory usage in MB"`
}

// SecurityImpact 安全影响
type SecurityImpact struct {
	AttacksPrevented   int      `json:"attacksPrevented" jsonschema:"Number of attacks prevented"`
	AttackTypes        []string `json:"attackTypes" jsonschema:"Types of attacks prevented"`
	TopBlockedIPs      []string `json:"topBlockedIPs" jsonschema:"Top blocked IP addresses"`
	RiskReductionScore float64  `json:"riskReductionScore" jsonschema:"Risk reduction score (0-100)"`
	ThreatCoverage     float64  `json:"threatCoverage" jsonschema:"Threat coverage percentage"`
}

// RuleAdjustment 规则调整建议
type RuleAdjustment struct {
	ShouldAdjust        bool     `json:"shouldAdjust" jsonschema:"Whether adjustment is needed"`
	AdjustmentType      string   `json:"adjustmentType" jsonschema:"Adjustment type (tighten, relax, or disable)"`
	SuggestedChanges    []string `json:"suggestedChanges" jsonschema:"Suggested modifications"`
	ExpectedImprovement string   `json:"expectedImprovement" jsonschema:"Expected improvement"`
}

// CreateEvaluateRuleEffectiveness 创建评估规则效果的工具函数
func CreateEvaluateRuleEffectiveness(client *APIClient) func(context.Context, *mcp.CallToolRequest, EvaluateRuleEffectivenessInput) (*mcp.CallToolResult, EvaluateRuleEffectivenessOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input EvaluateRuleEffectivenessInput) (*mcp.CallToolResult, EvaluateRuleEffectivenessOutput, error) {
		logger := NewToolLogger("evaluate_rule_effectiveness")
		logger.LogInput(input)

		if input.TimeRange == "" {
			input.TimeRange = "24h"
		}

		path := fmt.Sprintf("/api/v1/ai-analyzer/evaluate/rule/%s?timeRange=%s", input.RuleID, input.TimeRange)
		data, err := client.Get(path)
		if err != nil {
			logger.LogError(err)
			return nil, EvaluateRuleEffectivenessOutput{}, WrapError(err, "评估规则效果")
		}

		var result struct {
			Data EvaluateRuleEffectivenessOutput `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, EvaluateRuleEffectivenessOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("规则评估完成：效果评分%.1f，误报率%.2f%%",
			result.Data.EffectivenessScore, result.Data.FalsePositiveRate))
		return nil, result.Data, nil
	}
}

// OptimizeRuleInput 优化规则的输入参数
type OptimizeRuleInput struct {
	RuleID      string `json:"ruleId" jsonschema:"Rule ID"`
	OptimizeFor string `json:"optimizeFor" jsonschema:"Optimization target (accuracy, performance, or both)"`
	KeepHistory bool   `json:"keepHistory,omitempty" jsonschema:"Keep optimization history"`
}

// OptimizeRuleOutput 规则优化输出
type OptimizeRuleOutput struct {
	OriginalRuleID    string      `json:"originalRuleId" jsonschema:"Original rule ID"`
	OptimizedRuleID   string      `json:"optimizedRuleId" jsonschema:"Optimized rule ID"`
	Improvements      []string    `json:"improvements" jsonschema:"Improvement list"`
	BeforeMetrics     interface{} `json:"beforeMetrics" jsonschema:"Metrics before optimization"`
	AfterMetrics      interface{} `json:"afterMetrics" jsonschema:"Metrics after optimization"`
	RecommendedAction string      `json:"recommendedAction" jsonschema:"Recommended action"`
}

// CreateOptimizeRule 创建优化规则的工具函数
func CreateOptimizeRule(client *APIClient) func(context.Context, *mcp.CallToolRequest, OptimizeRuleInput) (*mcp.CallToolResult, OptimizeRuleOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input OptimizeRuleInput) (*mcp.CallToolResult, OptimizeRuleOutput, error) {
		logger := NewToolLogger("optimize_rule")
		logger.LogInput(input)

		if input.OptimizeFor == "" {
			input.OptimizeFor = "both"
		}

		requestData := map[string]interface{}{
			"ruleId":      input.RuleID,
			"optimizeFor": input.OptimizeFor,
			"keepHistory": input.KeepHistory,
		}

		data, err := client.Post("/api/v1/ai-analyzer/optimize/rule", requestData)
		if err != nil {
			logger.LogError(err)
			return nil, OptimizeRuleOutput{}, WrapError(err, "优化规则")
		}

		var result struct {
			Data OptimizeRuleOutput `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, OptimizeRuleOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("规则优化完成，共%d项改进", len(result.Data.Improvements)))
		return nil, result.Data, nil
	}
}

// CompareRulesInput 对比规则的输入参数
type CompareRulesInput struct {
	RuleID1   string `json:"ruleId1" jsonschema:"Rule 1 ID"`
	RuleID2   string `json:"ruleId2" jsonschema:"Rule 2 ID"`
	TimeRange string `json:"timeRange,omitempty" jsonschema:"Comparison time range (24h, 7d, or 30d)"`
}

// CompareRulesOutput 规则对比输出
type CompareRulesOutput struct {
	Rule1Metrics   interface{} `json:"rule1Metrics" jsonschema:"Rule 1 metrics"`
	Rule2Metrics   interface{} `json:"rule2Metrics" jsonschema:"Rule 2 metrics"`
	Winner         string      `json:"winner" jsonschema:"Rule ID with better performance"`
	Differences    []string    `json:"differences" jsonschema:"Key differences"`
	Recommendation string      `json:"recommendation" jsonschema:"Recommendations"`
}

// CreateCompareRules 创建对比规则的工具函数
func CreateCompareRules(client *APIClient) func(context.Context, *mcp.CallToolRequest, CompareRulesInput) (*mcp.CallToolResult, CompareRulesOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input CompareRulesInput) (*mcp.CallToolResult, CompareRulesOutput, error) {
		logger := NewToolLogger("compare_rules")
		logger.LogInput(input)

		if input.TimeRange == "" {
			input.TimeRange = "24h"
		}

		path := fmt.Sprintf("/api/v1/ai-analyzer/compare/rules?ruleId1=%s&ruleId2=%s&timeRange=%s",
			input.RuleID1, input.RuleID2, input.TimeRange)
		data, err := client.Get(path)
		if err != nil {
			logger.LogError(err)
			return nil, CompareRulesOutput{}, WrapError(err, "对比规则")
		}

		var result struct {
			Data CompareRulesOutput `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, CompareRulesOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("规则对比完成，优胜者：%s", result.Data.Winner))
		return nil, result.Data, nil
	}
}
