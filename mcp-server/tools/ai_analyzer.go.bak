// tools/ai_analyzer.go
// AI分析器工具
package tools

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// ListAttackPatternsInput 列出攻击模式的输入参数
type ListAttackPatternsInput struct {
	Page     int    `json:"page,omitempty" jsonschema:"Page number"`
	Size     int    `json:"size,omitempty" jsonschema:"Items per page"`
	Severity string `json:"severity,omitempty" jsonschema:"Severity level filter"`
}

// Validate 实现 Validator 接口
func (input *ListAttackPatternsInput) Validate() error {
	if input.Page < 0 {
		return NewValidationError("page", "必须大于等于0")
	}
	if input.Size > 100 {
		return NewValidationError("size", "不能超过100")
	}
	return nil
}

// ListAttackPatternsOutput 攻击模式列表输出
type ListAttackPatternsOutput struct {
	Total    int           `json:"total" jsonschema:"Total patterns count"`
	Patterns []interface{} `json:"patterns" jsonschema:"Attack patterns list"`
}

// CreateListAttackPatterns 创建列出政击模式的工具函数
//
// 功能说明：
//   - 列出AI检测到的攻击模式
//   - 支持按严重程度过滤
//   - 支持分页查询
//
// 参数说明：
//   - page: 页码，从1开始
//   - size: 每页数量，默认20
//   - severity: 严重程度过滤（可选）
func CreateListAttackPatterns(client *APIClient) func(context.Context, *mcp.CallToolRequest, ListAttackPatternsInput) (*mcp.CallToolResult, ListAttackPatternsOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input ListAttackPatternsInput) (*mcp.CallToolResult, ListAttackPatternsOutput, error) {
		logger := NewToolLoggerWithClient("list_attack_patterns", client)
		logger.LogInput(input)

		// 验证输入
		if err := ValidateInput(&input); err != nil {
			logger.LogError(err)
			return nil, ListAttackPatternsOutput{}, err
		}

		// 验证并规范化分页参数
		pagination := ValidatePagination(input.Page, input.Size)
		input.Page = pagination.Page
		input.Size = pagination.Size

		// 使用 URLBuilder 构建路径
		path := NewURLBuilder("/api/v1/ai-analyzer/patterns").
			AddParam("page", input.Page).
			AddParam("size", input.Size).
			AddParamIfNotEmpty("severity", input.Severity).
			Build()

		data, err := client.GetWithContext(ctx, path)
		if err != nil {
			logger.LogError(err)
			return nil, ListAttackPatternsOutput{}, WrapError(err, "查询攻击模式")
		}

		var result struct {
			Data struct {
				List  []interface{} `json:"list"`
				Total int           `json:"total"`
			} `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			return nil, ListAttackPatternsOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("返回 %d 个攻击模式", len(result.Data.List)))
		return nil, ListAttackPatternsOutput{
			Total:    result.Data.Total,
			Patterns: result.Data.List,
		}, nil
	}
}

// ListGeneratedRulesInput 列出生成规则的输入参数
type ListGeneratedRulesInput struct {
	Page   int    `json:"page,omitempty" jsonschema:"Page number"`
	Size   int    `json:"size,omitempty" jsonschema:"Items per page"`
	Status string `json:"status,omitempty" jsonschema:"Status filter (pending, approved, rejected, or deployed)"`
}

// Validate 实现 Validator 接口
func (input *ListGeneratedRulesInput) Validate() error {
	if input.Page < 0 {
		return NewValidationError("page", "必须大于等于0")
	}
	if input.Size > 100 {
		return NewValidationError("size", "不能超过100")
	}
	if input.Status != "" && input.Status != "pending" && input.Status != "approved" && input.Status != "rejected" && input.Status != "deployed" {
		return NewValidationError("status", "必须为 pending, approved, rejected 或 deployed")
	}
	return nil
}

// ListGeneratedRulesOutput 生成规则列表输出
type ListGeneratedRulesOutput struct {
	Total int           `json:"total" jsonschema:"Total rules count"`
	Rules []interface{} `json:"rules" jsonschema:"Rules list"`
}

// CreateListGeneratedRules 创建列出生成规则的工具函数
//
// 功能说明：
//   - 列出AI生成的防护规则
//   - 支持按状态过滤（待审核、已批准、已拒绝、已部署）
//   - 支持分页查询
//
// 参数说明：
//   - page: 页码，从1开始
//   - size: 每页数量，默认20
//   - status: 状态过滤（pending/approved/rejected/deployed）
func CreateListGeneratedRules(client *APIClient) func(context.Context, *mcp.CallToolRequest, ListGeneratedRulesInput) (*mcp.CallToolResult, ListGeneratedRulesOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input ListGeneratedRulesInput) (*mcp.CallToolResult, ListGeneratedRulesOutput, error) {
		logger := NewToolLoggerWithClient("list_generated_rules", client)
		logger.LogInput(input)

		// 验证输入
		if err := ValidateInput(&input); err != nil {
			logger.LogError(err)
			return nil, ListGeneratedRulesOutput{}, err
		}

		// 验证并规范化分页参数
		pagination := ValidatePagination(input.Page, input.Size)
		input.Page = pagination.Page
		input.Size = pagination.Size

		// 使用 URLBuilder 构建路径
		path := NewURLBuilder("/api/v1/ai-analyzer/rules").
			AddParam("page", input.Page).
			AddParam("size", input.Size).
			AddParamIfNotEmpty("status", input.Status).
			Build()

		data, err := client.GetWithContext(ctx, path)
		if err != nil {
			logger.LogError(err)
			return nil, ListGeneratedRulesOutput{}, WrapError(err, "查询生成规则")
		}

		var result struct {
			Data struct {
				List  []interface{} `json:"list"`
				Total int           `json:"total"`
			} `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			return nil, ListGeneratedRulesOutput{}, FormatParseError("响应", err)
		}

		return nil, ListGeneratedRulesOutput{
			Total: result.Data.Total,
			Rules: result.Data.List,
		}, nil
	}
}

// TriggerAIAnalysisInput 触发AI分析的输入参数
type TriggerAIAnalysisInput struct {
	Force bool `json:"force,omitempty" jsonschema:"Force immediate analysis"`
}

// TriggerAIAnalysisOutput AI分析输出
type TriggerAIAnalysisOutput struct {
	Message string `json:"message" jsonschema:"Analysis result message"`
}

// CreateTriggerAIAnalysis 创建触发AI分析的工具函数
func CreateTriggerAIAnalysis(client *APIClient) func(context.Context, *mcp.CallToolRequest, TriggerAIAnalysisInput) (*mcp.CallToolResult, TriggerAIAnalysisOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input TriggerAIAnalysisInput) (*mcp.CallToolResult, TriggerAIAnalysisOutput, error) {
		_, err := client.Post("/api/v1/ai-analyzer/trigger", map[string]bool{"force": input.Force})
		if err != nil {
			return nil, TriggerAIAnalysisOutput{}, WrapError(err, "触发分析")
		}

		return nil, TriggerAIAnalysisOutput{
			Message: "AI分析任务已启动，请稍后查看结果",
		}, nil
	}
}

// ReviewRuleInput 审核规则的输入参数
type ReviewRuleInput struct {
	RuleID  string `json:"ruleId" jsonschema:"Rule ID"`
	Action  string `json:"action" jsonschema:"enum=approve|reject,description=Review action"`
	Comment string `json:"comment,omitempty" jsonschema:"Review comment"`
}

// ReviewRuleOutput 审核规则输出
type ReviewRuleOutput struct {
	Message string `json:"message" jsonschema:"Review result message"`
}

// CreateReviewRule 创建审核规则的工具函数
func CreateReviewRule(client *APIClient) func(context.Context, *mcp.CallToolRequest, ReviewRuleInput) (*mcp.CallToolResult, ReviewRuleOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input ReviewRuleInput) (*mcp.CallToolResult, ReviewRuleOutput, error) {
		if input.Action != "approve" && input.Action != "reject" {
			return nil, ReviewRuleOutput{}, NewValidationErrorWithSuggestion(
				"action",
				"无效的审核动作，必须是approve或reject",
				"请使用 \"approve\" 批准规则或 \"reject\" 拒绝规则。",
			)
		}

		path := fmt.Sprintf("/api/v1/ai-analyzer/rules/%s/review", input.RuleID)
		_, err := client.Post(path, map[string]string{
			"action":  input.Action,
			"comment": input.Comment,
		})
		if err != nil {
			return nil, ReviewRuleOutput{}, WrapError(err, "审核规则")
		}

		message := "规则已批准"
		if input.Action == "reject" {
			message = "规则已拒绝"
		}

		return nil, ReviewRuleOutput{
			Message: message,
		}, nil
	}
}

// DeployRuleInput 部署规则的输入参数
type DeployRuleInput struct {
	RuleID string `json:"ruleId" jsonschema:"Rule ID to deploy"`
}

// DeployRuleOutput 部署规则输出
type DeployRuleOutput struct {
	Message string `json:"message" jsonschema:"Deployment result message"`
}

// CreateDeployRule 创建部署规则的工具函数
func CreateDeployRule(client *APIClient) func(context.Context, *mcp.CallToolRequest, DeployRuleInput) (*mcp.CallToolResult, DeployRuleOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input DeployRuleInput) (*mcp.CallToolResult, DeployRuleOutput, error) {
		path := fmt.Sprintf("/api/v1/ai-analyzer/rules/%s/deploy", input.RuleID)
		_, err := client.Post(path, nil)
		if err != nil {
			return nil, DeployRuleOutput{}, WrapError(err, "部署规则")
		}

		return nil, DeployRuleOutput{
			Message: "规则已成功部署到生产环境",
		}, nil
	}
}
