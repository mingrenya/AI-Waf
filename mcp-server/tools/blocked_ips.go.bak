// tools/blocked_ips.go
// IP封禁管理工具
package tools

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// ListBlockedIPsInput 列出封禁IP的输入参数
type ListBlockedIPsInput struct {
	Page int `json:"page,omitempty" jsonschema:"Page number"`
	Size int `json:"size,omitempty" jsonschema:"Items per page"`
}

// ListBlockedIPsOutput 封禁IP列表输出
type ListBlockedIPsOutput struct {
	Total int           `json:"total" jsonschema:"Total blocked IP count"`
	IPs   []interface{} `json:"ips" jsonschema:"Blocked IP detailed information"`
}

// CreateListBlockedIPs 创建列出封禁IP的工具函数
func CreateListBlockedIPs(client *APIClient) func(context.Context, *mcp.CallToolRequest, ListBlockedIPsInput) (*mcp.CallToolResult, ListBlockedIPsOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input ListBlockedIPsInput) (*mcp.CallToolResult, ListBlockedIPsOutput, error) {
		logger := NewToolLogger("list_blocked_ips")
		logger.LogInput(input)

		if input.Page == 0 {
			input.Page = 1
		}
		if input.Size == 0 {
			input.Size = 20
		}

		// 使用实际的API路径 /api/v1/blocked-ips
		path := fmt.Sprintf("/api/v1/blocked-ips?page=%d&pageSize=%d", input.Page, input.Size)
		data, err := client.Get(path)
		if err != nil {
			logger.LogError(err)
			return nil, ListBlockedIPsOutput{}, WrapError(err, "查询封禁IP")
		}

		var result struct {
			Data struct {
				Items []interface{} `json:"items"`
				Total int64         `json:"total"`
			} `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, ListBlockedIPsOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("返回 %d 个封禁IP(共%d个)", len(result.Data.Items), result.Data.Total))
		return nil, ListBlockedIPsOutput{
			Total: int(result.Data.Total),
			IPs:   result.Data.Items,
		}, nil
	}
}

// GetBlockedIPStatsInput 获取封禁IP统计的输入参数
type GetBlockedIPStatsInput struct{}

// GetBlockedIPStatsOutput 封禁IP统计输出
type GetBlockedIPStatsOutput struct {
	TotalBlocked int            `json:"totalBlocked" jsonschema:"Total blocked IP count"`
	ActiveBlocks int            `json:"activeBlocks" jsonschema:"Current active blocks count"`
	ReasonStats  map[string]int `json:"reasonStats" jsonschema:"Block reason statistics"`
}

// CreateGetBlockedIPStats 创建获取封禁IP统计的工具函数
func CreateGetBlockedIPStats(client *APIClient) func(context.Context, *mcp.CallToolRequest, GetBlockedIPStatsInput) (*mcp.CallToolResult, GetBlockedIPStatsOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input GetBlockedIPStatsInput) (*mcp.CallToolResult, GetBlockedIPStatsOutput, error) {
		logger := NewToolLogger("get_blocked_ip_stats")
		logger.LogInput(input)

		// 使用标准的API路径 /api/v1/blocked-ips/stats
		data, err := client.Get("/api/v1/blocked-ips/stats")
		if err != nil {
			logger.LogError(err)
			return nil, GetBlockedIPStatsOutput{}, WrapError(err, "获取统计")
		}

		var result struct {
			Data struct {
				TotalBlocked  int64          `json:"totalBlocked"`
				ActiveBlocked int64          `json:"activeBlocked"`
				ReasonStats   map[string]int `json:"reasonStats"`
			} `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, GetBlockedIPStatsOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("总封禁: %d, 活跃: %d", result.Data.TotalBlocked, result.Data.ActiveBlocked))
		return nil, GetBlockedIPStatsOutput{
			TotalBlocked: int(result.Data.TotalBlocked),
			ActiveBlocks: int(result.Data.ActiveBlocked),
			ReasonStats:  result.Data.ReasonStats,
		}, nil
	}
}
