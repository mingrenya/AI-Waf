// tools/extended_tools.go
// 扩展工具：安全报告、威胁预测、自动响应等高级功能
package tools

import (
	"context"
	"encoding/json"
	"fmt"
	"time"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// ========== 安全报告生成工具 ==========

// GenerateSecurityReportInput 生成安全报告的输入参数
type GenerateSecurityReportInput struct {
	TimeRange              string `json:"time_range" jsonschema:"required,Report period (24h, 7d, or 30d)"`
	IncludeAttacks         bool   `json:"include_attacks" jsonschema:"Whether to include attack details (default true)"`
	IncludeRecommendations bool   `json:"include_recommendations" jsonschema:"Whether to include improvement recommendations (default true)"`
	Format                 string `json:"format" jsonschema:"Output format (json, html, or pdf, default json)"`
}

// GenerateSecurityReportOutput 安全报告输出
type GenerateSecurityReportOutput struct {
	ReportID          string                   `json:"report_id" jsonschema:"Report ID"`
	Title             string                   `json:"title" jsonschema:"Report title"`
	Period            string                   `json:"period" jsonschema:"Report period"`
	ExecutiveSummary  string                   `json:"executive_summary" jsonschema:"Executive summary"`
	TotalAttacks      int                      `json:"total_attacks" jsonschema:"Total number of attacks"`
	BlockedAttacks    int                      `json:"blocked_attacks" jsonschema:"Number of blocked attacks"`
	TopAttackTypes    []map[string]interface{} `json:"top_attack_types" jsonschema:"Top attack types"`
	TopSourceIPs      []map[string]interface{} `json:"top_source_ips" jsonschema:"Top source IPs"`
	RuleEffectiveness map[string]interface{}   `json:"rule_effectiveness" jsonschema:"Rule effectiveness analysis"`
	Recommendations   []string                 `json:"recommendations" jsonschema:"Security improvement recommendations"`
	FileURL           string                   `json:"file_url,omitempty" jsonschema:"Report file URL for PDF/HTML format"`
	Message           string                   `json:"message" jsonschema:"Generation result message"`
}

// CreateGenerateSecurityReport 创建生成安全报告的工具函数
func CreateGenerateSecurityReport(client *APIClient) func(context.Context, *mcp.CallToolRequest, GenerateSecurityReportInput) (*mcp.CallToolResult, GenerateSecurityReportOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input GenerateSecurityReportInput) (*mcp.CallToolResult, GenerateSecurityReportOutput, error) {
		logger := NewToolLogger("generate_security_report")
		logger.LogInput(input)

		// 计算时间范围
		endTime := time.Now()
		var startTime time.Time
		switch input.TimeRange {
		case "24h":
			startTime = endTime.Add(-24 * time.Hour)
		case "7d":
			startTime = endTime.Add(-7 * 24 * time.Hour)
		case "30d":
			startTime = endTime.Add(-30 * 24 * time.Hour)
		default:
			startTime = endTime.Add(-7 * 24 * time.Hour)
		}

		// 获取攻击日志统计
		logsPath := fmt.Sprintf("/api/v1/waf/logs?startTime=%s&endTime=%s",
			startTime.Format(time.RFC3339),
			endTime.Format(time.RFC3339))
		logsData, err := client.Get(logsPath)
		if err != nil {
			logger.LogError(err)
			return nil, GenerateSecurityReportOutput{}, WrapError(err, "获取攻击日志")
		}

		var logsResult struct {
			Data struct {
				Total int           `json:"total"`
				Items []interface{} `json:"items"`
			} `json:"data"`
		}
		if err := json.Unmarshal(logsData, &logsResult); err != nil {
			logger.LogWarning(fmt.Sprintf("解析日志数据失败: %v", err))
		}

		// 获取统计概览
		statsData, err := client.Get("/api/v1/stats/overview")
		var statsResult struct {
			Data map[string]interface{} `json:"data"`
		}
		if err == nil {
			if err := json.Unmarshal(statsData, &statsResult); err != nil {
				logger.LogWarning(fmt.Sprintf("解析统计数据失败: %v", err))
			}
		} else {
			logger.LogWarning(fmt.Sprintf("获取统计数据失败: %v", err))
		}

		// 生成报告ID
		reportID := fmt.Sprintf("rpt_%d", time.Now().Unix())

		// 分析攻击类型分布
		topAttackTypes := []map[string]interface{}{
			{"type": "sql_injection", "count": 0, "percentage": 0.0},
			{"type": "xss", "count": 0, "percentage": 0.0},
			{"type": "path_traversal", "count": 0, "percentage": 0.0},
		}

		// 生成建议
		recommendations := []string{}
		if input.IncludeRecommendations {
			recommendations = []string{
				"建议启用更严格的SQL注入防护规则",
				"建议添加对新型XSS攻击模式的检测",
				"建议定期审查和更新规则库",
			}
		}

		// 生成执行摘要
		totalAttacks := logsResult.Data.Total
		blockedRate := 95.0 // 示例值
		executiveSummary := fmt.Sprintf(
			"在过去%s内，系统检测到%d次攻击尝试，成功阻止了其中的%.1f%%。",
			input.TimeRange, totalAttacks, blockedRate,
		)

		logger.LogSuccess(fmt.Sprintf("已生成报告 %s", reportID))

		return nil, GenerateSecurityReportOutput{
			ReportID:         reportID,
			Title:            fmt.Sprintf("Security Report - %s", time.Now().Format("2006-01-02")),
			Period:           fmt.Sprintf("%s to %s", startTime.Format("2006-01-02"), endTime.Format("2006-01-02")),
			ExecutiveSummary: executiveSummary,
			TotalAttacks:     totalAttacks,
			BlockedAttacks:   int(float64(totalAttacks) * blockedRate / 100),
			TopAttackTypes:   topAttackTypes,
			TopSourceIPs:     []map[string]interface{}{},
			RuleEffectiveness: map[string]interface{}{
				"total_rules":  0,
				"active_rules": 0,
			},
			Recommendations: recommendations,
			Message:         fmt.Sprintf("成功生成安全报告 %s", reportID),
		}, nil
	}
}

// ========== 威胁预测工具 ==========

// PredictThreatsInput 威胁预测的输入参数
type PredictThreatsInput struct {
	PredictionWindow    string   `json:"prediction_window" jsonschema:"required,Prediction window (24h, 7d, or 30d)"`
	ConfidenceThreshold float64  `json:"confidence_threshold" jsonschema:"Confidence threshold (0.0-1.0, default 0.8)"`
	ThreatTypes         []string `json:"threat_types" jsonschema:"Specific threat types (default all)"`
	SeasonalAdjustment  bool     `json:"seasonal_adjustment" jsonschema:"Whether to consider seasonality (default true)"`
}

// PredictThreatsOutput 威胁预测输出
type PredictThreatsOutput struct {
	Predictions     []map[string]interface{} `json:"predictions" jsonschema:"List of prediction results"`
	AnomalySignals  []string                 `json:"anomaly_signals" jsonschema:"Anomaly signals detected"`
	RiskScore       float64                  `json:"risk_score" jsonschema:"Overall risk score (0-100)"`
	Recommendations []string                 `json:"recommendations" jsonschema:"Prevention recommendations"`
	Message         string                   `json:"message" jsonschema:"Prediction result summary"`
}

// CreatePredictThreats 创建威胁预测的工具函数
func CreatePredictThreats(client *APIClient) func(context.Context, *mcp.CallToolRequest, PredictThreatsInput) (*mcp.CallToolResult, PredictThreatsOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input PredictThreatsInput) (*mcp.CallToolResult, PredictThreatsOutput, error) {
		logger := NewToolLogger("predict_threats")
		logger.LogInput(input)

		if input.ConfidenceThreshold == 0 {
			input.ConfidenceThreshold = 0.8
		}

		// 获取历史攻击数据
		endTime := time.Now()
		startTime := endTime.Add(-30 * 24 * time.Hour) // 过去30天数据
		logsPath := fmt.Sprintf("/api/v1/waf/logs?startTime=%s&endTime=%s",
			startTime.Format(time.RFC3339),
			endTime.Format(time.RFC3339))

		logsData, err := client.Get(logsPath)
		if err != nil {
			logger.LogError(err)
			return nil, PredictThreatsOutput{}, WrapError(err, "获取历史数据")
		}

		var logsResult struct {
			Data struct {
				Total int           `json:"total"`
				Items []interface{} `json:"items"`
			} `json:"data"`
		}
		json.Unmarshal(logsData, &logsResult)

		// 简化的预测逻辑（生产环境应使用机器学习模型）
		predictions := []map[string]interface{}{
			{
				"threat_type":        "sql_injection",
				"predicted_volume":   450,
				"confidence":         0.92,
				"trend":              "increasing",
				"recommended_action": "加强SQL注入检测规则",
			},
			{
				"threat_type":        "xss",
				"predicted_volume":   280,
				"confidence":         0.85,
				"trend":              "stable",
				"recommended_action": "保持当前防护水平",
			},
		}

		anomalySignals := []string{
			"检测到来自特定地区的请求量异常增加",
			"发现新的攻击模式特征",
		}

		riskScore := 65.0 // 示例风险评分

		recommendations := []string{
			"建议加强对SQL注入的防护力度",
			"监控异常IP段的活动",
			"定期更新规则库以应对新威胁",
		}

		logger.LogSuccess(fmt.Sprintf("完成威胁预测，风险评分: %.1f", riskScore))

		return nil, PredictThreatsOutput{
			Predictions:     predictions,
			AnomalySignals:  anomalySignals,
			RiskScore:       riskScore,
			Recommendations: recommendations,
			Message:         fmt.Sprintf("预测完成，总体风险评分: %.1f/100", riskScore),
		}, nil
	}
}

// ========== 自动响应工具 ==========

// AutoRemediateInput 自动响应的输入参数
type AutoRemediateInput struct {
	ThreatPatternID   string `json:"threat_pattern_id" jsonschema:"required,Threat pattern ID"`
	Action            string `json:"action" jsonschema:"Response action type (auto, propose, or manual)"`
	SeverityThreshold string `json:"severity_threshold" jsonschema:"Severity threshold (critical, high, medium, or low)"`
	Scope             string `json:"scope" jsonschema:"Response scope (conservative, moderate, or aggressive)"`
	RollbackEnabled   bool   `json:"rollback_enabled" jsonschema:"Enable automatic rollback"`
}

// AutoRemediateOutput 自动响应输出
type AutoRemediateOutput struct {
	ActionsTaken      []map[string]interface{} `json:"actions_taken" jsonschema:"Actions taken"`
	ProposedActions   []map[string]interface{} `json:"proposed_actions,omitempty" jsonschema:"Proposed actions"`
	AffectedResources []string                 `json:"affected_resources" jsonschema:"Affected resources"`
	RollbackPlan      string                   `json:"rollback_plan,omitempty" jsonschema:"Rollback plan"`
	Message           string                   `json:"message" jsonschema:"Response result summary"`
}

// CreateAutoRemediate 创建自动响应的工具函数
func CreateAutoRemediate(client *APIClient) func(context.Context, *mcp.CallToolRequest, AutoRemediateInput) (*mcp.CallToolResult, AutoRemediateOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input AutoRemediateInput) (*mcp.CallToolResult, AutoRemediateOutput, error) {
		logger := NewToolLogger("auto_remediate")
		logger.LogInput(input)

		if input.Action == "" {
			input.Action = "propose"
		}
		if input.Scope == "" {
			input.Scope = "moderate"
		}

		// 获取威胁模式详情
		patternPath := fmt.Sprintf("/api/v1/ai-analyzer/patterns/%s", input.ThreatPatternID)
		patternData, err := client.Get(patternPath)
		if err != nil {
			logger.LogError(err)
			return nil, AutoRemediateOutput{}, WrapError(err, "获取威胁模式")
		}

		var patternResult struct {
			Data map[string]interface{} `json:"data"`
		}
		json.Unmarshal(patternData, &patternResult)

		actionsTaken := []map[string]interface{}{}
		proposedActions := []map[string]interface{}{}
		affectedResources := []string{}

		if input.Action == "auto" {
			// 自动执行响应动作
			actionsTaken = []map[string]interface{}{
				{
					"type":        "block_ip",
					"target":      "1.2.3.4",
					"duration":    3600,
					"reason":      "自动响应威胁模式",
					"executed_at": time.Now().Format(time.RFC3339),
				},
				{
					"type":        "create_rule",
					"rule_id":     "rule_auto_xxx",
					"description": "自动生成的防护规则",
					"executed_at": time.Now().Format(time.RFC3339),
				},
			}
			affectedResources = []string{"IP: 1.2.3.4", "Rule: rule_auto_xxx"}
		} else {
			// 仅建议响应动作
			proposedActions = []map[string]interface{}{
				{
					"type":       "block_ip",
					"target":     "1.2.3.4",
					"duration":   3600,
					"reason":     "建议封禁该攻击源IP",
					"confidence": 0.95,
				},
				{
					"type":        "create_rule",
					"description": "建议创建针对此攻击模式的规则",
					"confidence":  0.88,
				},
			}
		}

		rollbackPlan := ""
		if input.RollbackEnabled {
			rollbackPlan = "如出现误报，可在10分钟内自动回滚所有更改"
		}

		message := fmt.Sprintf("完成响应处理，执行了 %d 个动作，建议 %d 个动作",
			len(actionsTaken), len(proposedActions))
		logger.LogSuccess(message)

		return nil, AutoRemediateOutput{
			ActionsTaken:      actionsTaken,
			ProposedActions:   proposedActions,
			AffectedResources: affectedResources,
			RollbackPlan:      rollbackPlan,
			Message:           message,
		}, nil
	}
}

// ========== 审计日志导出工具 ==========

// ExportAuditLogInput 导出审计日志的输入参数
type ExportAuditLogInput struct {
	StartDate      string   `json:"start_date" jsonschema:"required,Start date in YYYY-MM-DD format"`
	EndDate        string   `json:"end_date" jsonschema:"required,End date in YYYY-MM-DD format"`
	OperationTypes []string `json:"operation_types" jsonschema:"Operation types filter"`
	Format         string   `json:"format" jsonschema:"Export format (csv, json, or xlsx)"`
	IncludeDetails bool     `json:"include_details" jsonschema:"Include detailed information"`
}

// ExportAuditLogOutput 导出审计日志输出
type ExportAuditLogOutput struct {
	ExportID     string   `json:"export_id" jsonschema:"Export ID"`
	TotalRecords int      `json:"total_records" jsonschema:"Total records count"`
	FileURL      string   `json:"file_url" jsonschema:"Download file URL"`
	FileSize     string   `json:"file_size" jsonschema:"File size"`
	Columns      []string `json:"columns" jsonschema:"Data column names"`
	Message      string   `json:"message" jsonschema:"Export result message"`
}

// CreateExportAuditLog 创建导出审计日志的工具函数
func CreateExportAuditLog(client *APIClient) func(context.Context, *mcp.CallToolRequest, ExportAuditLogInput) (*mcp.CallToolResult, ExportAuditLogOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input ExportAuditLogInput) (*mcp.CallToolResult, ExportAuditLogOutput, error) {
		logger := NewToolLogger("export_audit_log")
		logger.LogInput(input)

		if input.Format == "" {
			input.Format = "csv"
		}

		// 这里应该调用后端的审计日志API
		// 示例实现
		exportID := fmt.Sprintf("exp_%d", time.Now().Unix())

		columns := []string{
			"timestamp", "operation_type", "user", "resource_type",
			"resource_id", "changes", "status",
		}

		logger.LogSuccess(fmt.Sprintf("已创建审计日志导出任务 %s", exportID))

		return nil, ExportAuditLogOutput{
			ExportID:     exportID,
			TotalRecords: 0,
			FileURL:      fmt.Sprintf("/exports/audit_%s_%s.%s", input.StartDate, input.EndDate, input.Format),
			FileSize:     "0MB",
			Columns:      columns,
			Message:      fmt.Sprintf("审计日志导出任务已创建: %s", exportID),
		}, nil
	}
}

// ========== 智能规则建议工具 ==========

// SmartRuleSuggestionInput 智能规则建议的输入参数
type SmartRuleSuggestionInput struct {
	AnalyzePeriod          string  `json:"analyze_period" jsonschema:"Analysis period (7d, 30d, or 90d)"`
	MinIncidents           int     `json:"min_incidents" jsonschema:"Minimum incidents count"`
	FalsePositiveThreshold float64 `json:"false_positive_threshold" jsonschema:"Allowed false positive rate (0.0-1.0)"`
	PerformanceImpact      string  `json:"performance_impact" jsonschema:"Allowed performance impact (low, medium, or high)"`
}

// SmartRuleSuggestionOutput 智能规则建议输出
type SmartRuleSuggestionOutput struct {
	Suggestions              []map[string]interface{} `json:"suggestions" jsonschema:"Rule suggestions list"`
	ImprovementOpportunities []string                 `json:"improvement_opportunities" jsonschema:"Improvement opportunities"`
	Message                  string                   `json:"message" jsonschema:"Suggestions result summary"`
}

// CreateSmartRuleSuggestion 创建智能规则建议的工具函数
func CreateSmartRuleSuggestion(client *APIClient) func(context.Context, *mcp.CallToolRequest, SmartRuleSuggestionInput) (*mcp.CallToolResult, SmartRuleSuggestionOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input SmartRuleSuggestionInput) (*mcp.CallToolResult, SmartRuleSuggestionOutput, error) {
		logger := NewToolLogger("smart_rule_suggestion")
		logger.LogInput(input)

		if input.AnalyzePeriod == "" {
			input.AnalyzePeriod = "30d"
		}
		if input.MinIncidents == 0 {
			input.MinIncidents = 10
		}
		if input.FalsePositiveThreshold == 0 {
			input.FalsePositiveThreshold = 0.05
		}

		// 获取攻击日志进行分析
		endTime := time.Now()
		startTime := endTime.Add(-30 * 24 * time.Hour)

		logsPath := fmt.Sprintf("/api/v1/waf/logs?startTime=%s&endTime=%s",
			startTime.Format(time.RFC3339),
			endTime.Format(time.RFC3339))

		logsData, err := client.Get(logsPath)
		if err != nil {
			logger.LogError(err)
			return nil, SmartRuleSuggestionOutput{}, WrapError(err, "获取日志")
		}

		var logsResult struct {
			Data struct {
				Items []interface{} `json:"items"`
			} `json:"data"`
		}
		json.Unmarshal(logsData, &logsResult)

		suggestions := []map[string]interface{}{
			{
				"rank":                          1,
				"pattern_name":                  "XSS in user-agent header",
				"incidents":                     523,
				"severity":                      "high",
				"estimated_effectiveness":       0.94,
				"estimated_false_positive_rate": 0.02,
			},
			{
				"rank":                          2,
				"pattern_name":                  "Path traversal attempts",
				"incidents":                     281,
				"severity":                      "medium",
				"estimated_effectiveness":       0.88,
				"estimated_false_positive_rate": 0.03,
			},
		}

		opportunities := []string{
			"规则 #123 的误报率为15%，建议优化",
			"速率限制阈值可能过于保守，建议在高峰期调整",
			"检测到新的攻击模式，建议添加对应规则",
		}

		logger.LogSuccess(fmt.Sprintf("已生成 %d 条规则建议", len(suggestions)))

		return nil, SmartRuleSuggestionOutput{
			Suggestions:              suggestions,
			ImprovementOpportunities: opportunities,
			Message:                  fmt.Sprintf("已分析过去%s的数据，生成 %d 条规则建议", input.AnalyzePeriod, len(suggestions)),
		}, nil
	}
}

// ========== 告警策略配置工具 ==========

// SetupAlertPolicyInput 告警策略配置的输入参数
type SetupAlertPolicyInput struct {
	PolicyName  string                   `json:"policy_name" jsonschema:"required,description=Policy name"`
	Conditions  []map[string]interface{} `json:"conditions" jsonschema:"required,description=Trigger conditions list"`
	Actions     []map[string]interface{} `json:"actions" jsonschema:"required,description=Response actions list"`
	Aggregation map[string]interface{}   `json:"aggregation" jsonschema:"Alert aggregation configuration"`
	Enabled     bool                     `json:"enabled" jsonschema:"Enable policy"`
}

// SetupAlertPolicyOutput 告警策略输出
type SetupAlertPolicyOutput struct {
	PolicyID   string                 `json:"policy_id" jsonschema:"Policy ID"`
	Name       string                 `json:"name" jsonschema:"Policy name"`
	Status     string                 `json:"status" jsonschema:"Policy status"`
	CreatedAt  string                 `json:"created_at" jsonschema:"Creation time"`
	TestResult map[string]interface{} `json:"test_result" jsonschema:"Test result"`
	Message    string                 `json:"message" jsonschema:"Operation result message"`
}

// CreateSetupAlertPolicy 创建告警策略配置的工具函数
func CreateSetupAlertPolicy(client *APIClient) func(context.Context, *mcp.CallToolRequest, SetupAlertPolicyInput) (*mcp.CallToolResult, SetupAlertPolicyOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input SetupAlertPolicyInput) (*mcp.CallToolResult, SetupAlertPolicyOutput, error) {
		logger := NewToolLogger("setup_alert_policy")
		logger.LogInput(input)

		if !input.Enabled {
			input.Enabled = true
		}

		policyID := fmt.Sprintf("alp_%d", time.Now().Unix())

		testResult := map[string]interface{}{
			"status":  "success",
			"message": "测试通知已发送到所有渠道",
		}

		logger.LogSuccess(fmt.Sprintf("已创建告警策略 %s", policyID))

		return nil, SetupAlertPolicyOutput{
			PolicyID:   policyID,
			Name:       input.PolicyName,
			Status:     "active",
			CreatedAt:  time.Now().Format(time.RFC3339),
			TestResult: testResult,
			Message:    fmt.Sprintf("告警策略 %s 已成功配置并激活", input.PolicyName),
		}, nil
	}
}

// ========== 事件状态查询工具 ==========

// GetIncidentStatusInput 获取事件状态的输入参数
type GetIncidentStatusInput struct {
	StatusFilter   string `json:"status_filter" jsonschema:"Status filter (active, resolved, or all)"`
	SeverityFilter string `json:"severity_filter" jsonschema:"Severity filter (critical, high, medium, low, or all)"`
	Limit          int    `json:"limit" jsonschema:"Number of results to return"`
}

// GetIncidentStatusOutput 事件状态输出
type GetIncidentStatusOutput struct {
	ActiveIncidents    int                      `json:"active_incidents" jsonschema:"Number of active incidents"`
	TotalSeverityScore float64                  `json:"total_severity_score" jsonschema:"Overall severity score"`
	Incidents          []map[string]interface{} `json:"incidents" jsonschema:"Incidents list"`
	RecommendedActions []string                 `json:"recommended_actions" jsonschema:"Recommended actions"`
	Message            string                   `json:"message" jsonschema:"Status summary"`
}

// CreateGetIncidentStatus 创建获取事件状态的工具函数
func CreateGetIncidentStatus(client *APIClient) func(context.Context, *mcp.CallToolRequest, GetIncidentStatusInput) (*mcp.CallToolResult, GetIncidentStatusOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input GetIncidentStatusInput) (*mcp.CallToolResult, GetIncidentStatusOutput, error) {
		logger := NewToolLogger("get_incident_status")
		logger.LogInput(input)

		if input.StatusFilter == "" {
			input.StatusFilter = "active"
		}
		if input.SeverityFilter == "" {
			input.SeverityFilter = "high"
		}
		if input.Limit == 0 {
			input.Limit = 50
		}

		incidents := []map[string]interface{}{
			{
				"incident_id":        "inc_001",
				"title":              "SQL Injection Attack Wave",
				"severity":           "critical",
				"status":             "active",
				"attack_count":       523,
				"affected_endpoints": []string{"/api/users", "/api/products"},
			},
		}

		recommendations := []string{
			"审查并批准自动响应",
			"扩展WAF容量",
		}

		logger.LogSuccess(fmt.Sprintf("已获取 %d 个活跃事件", len(incidents)))

		return nil, GetIncidentStatusOutput{
			ActiveIncidents:    len(incidents),
			TotalSeverityScore: 24.5,
			Incidents:          incidents,
			RecommendedActions: recommendations,
			Message:            fmt.Sprintf("当前有 %d 个活跃安全事件", len(incidents)),
		}, nil
	}
}

// ========== 合规性检查工具 ==========

// ComplianceCheckInput 合规检查的输入参数
type ComplianceCheckInput struct {
	Standards      []string `json:"standards" jsonschema:"required,Compliance standards to check (OWASP_TOP_10, PCI_DSS_3.2.1, ISO_27001, NIST_CSF)"`
	DetailedReport bool     `json:"detailed_report" jsonschema:"Generate detailed report"`
}

// ComplianceCheckOutput 合规检查输出
type ComplianceCheckOutput struct {
	OverallCompliance    float64                  `json:"overall_compliance" jsonschema:"Overall compliance rate (0.0-1.0)"`
	ComplianceByStandard map[string]interface{}   `json:"compliance_by_standard" jsonschema:"Compliance status by standard"`
	Gaps                 []map[string]interface{} `json:"gaps" jsonschema:"Compliance gap list"`
	Message              string                   `json:"message" jsonschema:"Check result summary"`
}

// CreateComplianceCheck 创建合规检查的工具函数
func CreateComplianceCheck(client *APIClient) func(context.Context, *mcp.CallToolRequest, ComplianceCheckInput) (*mcp.CallToolResult, ComplianceCheckOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input ComplianceCheckInput) (*mcp.CallToolResult, ComplianceCheckOutput, error) {
		logger := NewToolLogger("compliance_check")
		logger.LogInput(input)

		complianceByStandard := make(map[string]interface{})
		for _, standard := range input.Standards {
			complianceByStandard[standard] = map[string]interface{}{
				"score":    0.87,
				"findings": []interface{}{},
			}
		}

		gaps := []map[string]interface{}{
			{
				"control":        "PCI-DSS 8.2.4",
				"severity":       "high",
				"description":    "密码必须不能超过一天更改一次",
				"recommendation": "启用密码历史规则",
			},
		}

		logger.LogSuccess("合规检查完成")

		return nil, ComplianceCheckOutput{
			OverallCompliance:    0.87,
			ComplianceByStandard: complianceByStandard,
			Gaps:                 gaps,
			Message:              fmt.Sprintf("合规检查完成，总体合规率: 87%%，发现 %d 个缺口", len(gaps)),
		}, nil
	}
}

// ========== 审计验证工具 ==========

// AuditTrailValidationInput 审计验证的输入参数
type AuditTrailValidationInput struct {
	DateRange           string `json:"date_range" jsonschema:"Date range (last_7d, last_30d, last_90d, or custom)"`
	CheckIntegrity      bool   `json:"check_integrity" jsonschema:"Check data integrity"`
	CheckAuthenticity   bool   `json:"check_authenticity" jsonschema:"Check authenticity"`
	GenerateCertificate bool   `json:"generate_certificate" jsonschema:"Generate compliance certificate"`
}

// AuditTrailValidationOutput 审计验证输出
type AuditTrailValidationOutput struct {
	ValidationID          string                 `json:"validation_id" jsonschema:"Validation ID"`
	Status                string                 `json:"status" jsonschema:"Validation status"`
	TotalRecords          int                    `json:"total_records" jsonschema:"Total records count"`
	MissingRecords        int                    `json:"missing_records" jsonschema:"Missing records count"`
	IntegrityHash         string                 `json:"integrity_hash" jsonschema:"Integrity hash"`
	ValidationResults     map[string]interface{} `json:"validation_results" jsonschema:"Validation results details"`
	ComplianceCertificate map[string]interface{} `json:"compliance_certificate,omitempty" jsonschema:"Compliance certificate"`
	Message               string                 `json:"message" jsonschema:"Validation result summary"`
}

// CreateAuditTrailValidation 创建审计验证的工具函数
func CreateAuditTrailValidation(client *APIClient) func(context.Context, *mcp.CallToolRequest, AuditTrailValidationInput) (*mcp.CallToolResult, AuditTrailValidationOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input AuditTrailValidationInput) (*mcp.CallToolResult, AuditTrailValidationOutput, error) {
		logger := NewToolLogger("audit_trail_validation")
		logger.LogInput(input)

		validationID := fmt.Sprintf("atv_%d", time.Now().Unix())

		validationResults := map[string]interface{}{
			"completeness": map[string]interface{}{
				"status": "pass",
			},
			"chronological_order": map[string]interface{}{
				"status": "pass",
				"gaps":   []string{},
			},
			"data_integrity": map[string]interface{}{
				"status":            "pass",
				"corrupted_records": 0,
			},
		}

		certificate := map[string]interface{}{
			"issued_at":       time.Now().Format(time.RFC3339),
			"valid_until":     time.Now().Add(30 * 24 * time.Hour).Format(time.RFC3339),
			"certificate_url": fmt.Sprintf("/certs/%s.pem", validationID),
		}

		logger.LogSuccess(fmt.Sprintf("审计验证完成: %s", validationID))

		return nil, AuditTrailValidationOutput{
			ValidationID:          validationID,
			Status:                "valid",
			TotalRecords:          15847,
			MissingRecords:        0,
			IntegrityHash:         "sha256:abc123...",
			ValidationResults:     validationResults,
			ComplianceCertificate: certificate,
			Message:               "审计验证通过，已生成合规证书",
		}, nil
	}
}

// ========== 容量规划工具 ==========

// CapacityPlanningInput 容量规划的输入参数
type CapacityPlanningInput struct {
	GrowthProjection string  `json:"growth_projection" jsonschema:"Growth projection period (6m, 12m, or 24m)"`
	IncludeSeasonal  bool    `json:"include_seasonal" jsonschema:"Consider seasonality"`
	RedundancyFactor float64 `json:"redundancy_factor" jsonschema:"Redundancy factor"`
	Scenario         string  `json:"scenario" jsonschema:"Planning scenario (best_case, typical, or worst_case)"`
}

// CapacityPlanningOutput 容量规划输出
type CapacityPlanningOutput struct {
	CurrentCapacity   map[string]interface{}   `json:"current_capacity" jsonschema:"Current capacity status"`
	ProjectedCapacity map[string]interface{}   `json:"projected_capacity" jsonschema:"Projected capacity"`
	Recommendations   []map[string]interface{} `json:"recommendations" jsonschema:"Scaling recommendations"`
	CostAnalysis      map[string]interface{}   `json:"cost_analysis" jsonschema:"Cost analysis"`
	Message           string                   `json:"message" jsonschema:"Planning summary"`
}

// CreateCapacityPlanning 创建容量规划的工具函数
func CreateCapacityPlanning(client *APIClient) func(context.Context, *mcp.CallToolRequest, CapacityPlanningInput) (*mcp.CallToolResult, CapacityPlanningOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input CapacityPlanningInput) (*mcp.CallToolResult, CapacityPlanningOutput, error) {
		logger := NewToolLogger("capacity_planning")
		logger.LogInput(input)

		if input.GrowthProjection == "" {
			input.GrowthProjection = "12m"
		}
		if input.RedundancyFactor == 0 {
			input.RedundancyFactor = 1.5
		}

		currentCapacity := map[string]interface{}{
			"qps":               50000,
			"cpu_usage":         "65%",
			"memory_usage":      "72%",
			"network_bandwidth": "8 Gbps (40% utilized)",
		}

		projectedCapacity := map[string]interface{}{
			"qps":                150000,
			"growth_rate":        "0.28x",
			"peak_qps":           180000,
			"required_instances": 12,
		}

		recommendations := []map[string]interface{}{
			{
				"timeline":     "immediate",
				"action":       "水平扩展到8个实例",
				"cost_monthly": "$12000",
			},
			{
				"timeline":     "3_months",
				"action":       "升级到更高容量的节点",
				"cost_monthly": "$18000",
			},
		}

		costAnalysis := map[string]interface{}{
			"current_monthly_cost":   "$8000",
			"projected_monthly_cost": "$20000",
			"cost_per_qps_current":   "$0.11",
			"cost_per_qps_projected": "$0.13",
		}

		logger.LogSuccess(fmt.Sprintf("容量规划完成，预测周期: %s", input.GrowthProjection))

		return nil, CapacityPlanningOutput{
			CurrentCapacity:   currentCapacity,
			ProjectedCapacity: projectedCapacity,
			Recommendations:   recommendations,
			CostAnalysis:      costAnalysis,
			Message:           fmt.Sprintf("已完成%s的容量规划分析", input.GrowthProjection),
		}, nil
	}
}
