// tools/logs.go
// WAF日志查询工具
package tools

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// ListAttackLogsInput 查询攻击日志的输入参数
type ListAttackLogsInput struct {
	Page      int    `json:"page,omitempty" jsonschema:"Page number starting from 1"`
	PageSize  int    `json:"pageSize,omitempty" jsonschema:"Number of items per page (1-100)"`
	RuleID    int    `json:"ruleId,omitempty" jsonschema:"Filter by specific rule ID"`
	SrcIP     string `json:"srcIp,omitempty" jsonschema:"Filter by source IP address (supports CIDR notation)"`
	DstIP     string `json:"dstIp,omitempty" jsonschema:"Filter by destination IP address"`
	Domain    string `json:"domain,omitempty" jsonschema:"Filter by domain name"`
	StartTime string `json:"startTime,omitempty" jsonschema:"Query start time in ISO8601 format (YYYY-MM-DDTHH:MM:SSZ)"`
	EndTime   string `json:"endTime,omitempty" jsonschema:"Query end time in ISO8601 format (YYYY-MM-DDTHH:MM:SSZ)"`
}

// Validate 实现 Validator 接口
func (input *ListAttackLogsInput) Validate() error {
	if input.PageSize > 100 {
		return NewValidationErrorWithSuggestion(
			"pageSize",
			"不能超过100",
			"请将 pageSize 设置为 1-100 之间的值。对于大量数据，建议使用分页多次请求。",
		)
	}
	if input.Page < 0 {
		return NewValidationErrorWithSuggestion(
			"page",
			"必须大于0",
			"页码从 1 开始。如需获取第一页数据，请将 page 设置为 1。",
		)
	}
	return nil
}

// ListAttackLogsOutput 攻击日志输出
type ListAttackLogsOutput struct {
	Count int           `json:"count" jsonschema:"Total number of attack logs matching the filter criteria"`
	Logs  []interface{} `json:"logs" jsonschema:"Array of attack log entries with detailed information including timestamp, source IP, attack type and severity"`
}

// CreateListAttackLogs 创建查询攻击日志的工具函数
//
// 功能说明：
//   - 查询WAF攻击日志，支持多维度过滤
//   - 支持分页查询，最大单页100条记录
//   - 支持按时间范围、IP、域名、规则ID过滤
//
// 参数说明：
//   - page: 页码，从1开始，默认1
//   - pageSize: 每页数量，默认20，最大100
//   - ruleId: 规则ID过滤（可选）
//   - srcIp: 来源IP过滤（可选）
//   - dstIp: 目标IP过滤（可选）
//   - domain: 域名过滤（可选）
//   - startTime: 开始时间，ISO8601格式（可选）
//   - endTime: 结束时间，ISO8601格式（可选）
//
// 返回数据：
//   - count: 总记录数
//   - logs: 日志详细信息数组
//
// 使用示例：
//
//	input := ListAttackLogsInput{Page: 1, PageSize: 20, SrcIP: "192.168.1.1"}
//	result, output, err := handler(ctx, req, input)
func CreateListAttackLogs(client *APIClient) func(context.Context, *mcp.CallToolRequest, ListAttackLogsInput) (*mcp.CallToolResult, ListAttackLogsOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input ListAttackLogsInput) (*mcp.CallToolResult, ListAttackLogsOutput, error) {
		logger := NewToolLoggerWithClient("list_attack_logs", client)
		logger.LogInput(input)

		// 验证输入
		if err := ValidateInput(&input); err != nil {
			logger.LogError(err)
			return nil, ListAttackLogsOutput{}, err
		}

		// 设置默认值
		if input.Page == 0 {
			input.Page = 1
		}
		if input.PageSize == 0 {
			input.PageSize = 20
		}

		// 使用 URLBuilder 构建路径
		path := NewURLBuilder("/api/v1/log").
			AddParam("page", input.Page).
			AddParam("pageSize", input.PageSize).
			AddParam("ruleId", input.RuleID).
			AddParamIfNotEmpty("srcIp", input.SrcIP).
			AddParamIfNotEmpty("dstIp", input.DstIP).
			AddParamIfNotEmpty("domain", input.Domain).
			AddParamIfNotEmpty("startTime", input.StartTime).
			AddParamIfNotEmpty("endTime", input.EndTime).
			Build()

		// 调用后端API（使用带context的方法）
		data, err := client.GetWithContext(ctx, path)
		if err != nil {
			logger.LogError(err)
			return nil, ListAttackLogsOutput{}, WrapError(err, "查询日志")
		}

		// 解析响应 - 匹配AttackLogResponse结构
		var result struct {
			Data struct {
				Results     []interface{} `json:"results"`
				TotalCount  int64         `json:"totalCount"`
				PageSize    int           `json:"pageSize"`
				CurrentPage int           `json:"currentPage"`
				TotalPages  int           `json:"totalPages"`
			} `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, ListAttackLogsOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("返回 %d 条日志(共%d条)", len(result.Data.Results), result.Data.TotalCount))
		return nil, ListAttackLogsOutput{
			Count: int(result.Data.TotalCount),
			Logs:  result.Data.Results,
		}, nil
	}
}

// GetLogStatsInput 获取日志统计的输入参数
type GetLogStatsInput struct {
	Page      int    `json:"page,omitempty" jsonschema:"Page number for pagination"`
	PageSize  int    `json:"pageSize,omitempty" jsonschema:"Number of items per page"`
	SrcIP     string `json:"srcIp,omitempty" jsonschema:"Filter statistics by source IP address"`
	DstIP     string `json:"dstIp,omitempty" jsonschema:"Filter statistics by destination IP"`
	Domain    string `json:"domain,omitempty" jsonschema:"Filter statistics by domain name"`
	StartTime string `json:"startTime,omitempty" jsonschema:"Statistics start time in ISO8601 format"`
	EndTime   string `json:"endTime,omitempty" jsonschema:"Statistics end time in ISO8601 format"`
}

// GetLogStatsOutput 日志统计输出
type GetLogStatsOutput struct {
	TotalAttacks         int                      `json:"totalAttacks" jsonschema:"Total number of attack attempts in the period"`
	AttackTypes          map[string]int           `json:"attackTypes" jsonschema:"Breakdown of attacks by type (sql_injection\\"`
	TopSourceIPs         []map[string]interface{} `json:"topSourceIPs" jsonschema:"Top 10 attack source IPs with counts and percentages"`
	SeverityDistribution map[string]int           `json:"severityDistribution" jsonschema:"Distribution of attacks by severity level (low\\"`
}

// CreateGetLogStats 创建获取日志统计的工具函数(基于攻击事件聚合)
func CreateGetLogStats(client *APIClient) func(context.Context, *mcp.CallToolRequest, GetLogStatsInput) (*mcp.CallToolResult, GetLogStatsOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input GetLogStatsInput) (*mcp.CallToolResult, GetLogStatsOutput, error) {
		logger := NewToolLoggerWithClient("get_log_stats", client)
		logger.LogInput(input)

		// 设置默认值
		if input.Page == 0 {
			input.Page = 1
		}
		if input.PageSize == 0 {
			input.PageSize = 20
		}

		// 使用正确的API路径 /api/v1/waf/logs/events（使用URL编码）
		params := fmt.Sprintf("page=%d&pageSize=%d", input.Page, input.PageSize)
		if input.SrcIP != "" {
			params += "&srcIp=" + input.SrcIP // IP地址不需要编码
		}
		if input.DstIP != "" {
			params += "&dstIp=" + input.DstIP // IP地址不需要编码
		}
		if input.Domain != "" {
			params += "&domain=" + input.Domain // 域名通常不需要编码
		}
		if input.StartTime != "" {
			params += "&startTime=" + input.StartTime // ISO8601格式不需要编码
		}
		if input.EndTime != "" {
			params += "&endTime=" + input.EndTime // ISO8601格式不需要编码
		}
		path := "/api/v1/waf/logs/events?" + params

		data, err := client.Get(path)
		if err != nil {
			logger.LogError(err)
			return nil, GetLogStatsOutput{}, WrapError(err, "获取统计")
		}

		// 解析AttackEventResponse
		var result struct {
			Data struct {
				Results     []map[string]interface{} `json:"results"`
				TotalCount  int64                    `json:"totalCount"`
				CurrentPage int                      `json:"currentPage"`
			} `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, GetLogStatsOutput{}, FormatParseError("响应", err)
		}

		// 聚合统计信息
		attackTypes := make(map[string]int)
		severityDist := make(map[string]int)
		totalAttacks := 0
		topIPs := []map[string]interface{}{}

		for _, event := range result.Data.Results {
			if count, ok := event["count"].(float64); ok {
				totalAttacks += int(count)
			}
			if srcIP, ok := event["srcIp"].(string); ok {
				topIPs = append(topIPs, event)
				_ = srcIP
			}
		}

		logger.LogSuccess(fmt.Sprintf("返回 %d 个攻击事件统计", len(result.Data.Results)))
		return nil, GetLogStatsOutput{
			TotalAttacks:         totalAttacks,
			AttackTypes:          attackTypes,
			TopSourceIPs:         topIPs,
			SeverityDistribution: severityDist,
		}, nil
	}
}
