// tools/sites.go
// 站点管理工具
package tools

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// ListSitesInput 列出站点的输入参数
type ListSitesInput struct{}

// ListSitesOutput 站点列表输出
type ListSitesOutput struct {
	Total int           `json:"total" jsonschema:"Total sites count"`
	Sites []interface{} `json:"sites" jsonschema:"Sites list"`
}

// CreateListSites 创建列出站点的工具函数
//
// 功能说明：
//   - 列出所有受WAF保护的站点配置
//   - 返回站点的基本信息（域名、状态等）
//
// 返回数据：
//   - total: 总站点数
//   - sites: 站点列表
func CreateListSites(client *APIClient) func(context.Context, *mcp.CallToolRequest, ListSitesInput) (*mcp.CallToolResult, ListSitesOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input ListSitesInput) (*mcp.CallToolResult, ListSitesOutput, error) {
		logger := NewToolLoggerWithClient("list_sites", client)

		// 使用实际的API路径 /api/v1/site
		data, err := client.GetWithContext(ctx, "/api/v1/site")
		if err != nil {
			logger.LogError(err)
			return nil, ListSitesOutput{}, WrapError(err, "查询站点")
		}

		var result struct {
			Data []interface{} `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, ListSitesOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess(fmt.Sprintf("返回 %d 个站点", len(result.Data)))
		return nil, ListSitesOutput{
			Total: len(result.Data),
			Sites: result.Data,
		}, nil
	}
}

// GetSiteDetailsInput 获取站点详情的输入参数
type GetSiteDetailsInput struct {
	SiteID string `json:"siteId" jsonschema:"Site ID"`
}

// Validate 实现 Validator 接口
func (input *GetSiteDetailsInput) Validate() error {
	if input.SiteID == "" {
		return NewValidationErrorWithSuggestion(
			"siteId",
			"站点ID不能为空",
			"请使用 ai_waf_list_sites 工具获取所有站点列表，然后使用目标站点的 ID。",
		)
	}
	return nil
}

// GetSiteDetailsOutput 站点详情输出
type GetSiteDetailsOutput struct {
	Site interface{} `json:"site" jsonschema:"Site detailed information"`
}

// CreateGetSiteDetails 创建获取站点详情的工具函数
//
// 功能说明：
//   - 获取指定站点的详细配置信息
//   - 包括域名、后端服务器、规则配置等
//
// 参数说明：
//   - siteId: 站点ID（必填）
//
// 返回数据：
//   - site: 站点详细信息对象
func CreateGetSiteDetails(client *APIClient) func(context.Context, *mcp.CallToolRequest, GetSiteDetailsInput) (*mcp.CallToolResult, GetSiteDetailsOutput, error) {
	return func(ctx context.Context, req *mcp.CallToolRequest, input GetSiteDetailsInput) (*mcp.CallToolResult, GetSiteDetailsOutput, error) {
		logger := NewToolLoggerWithClient("get_site_details", client)
		logger.LogInput(input)

		// 验证输入
		if err := ValidateInput(&input); err != nil {
			logger.LogError(err)
			return nil, GetSiteDetailsOutput{}, err
		}

		// 使用实际的API路径 /api/v1/site/{id}
		path := fmt.Sprintf("/api/v1/site/%s", input.SiteID)
		data, err := client.GetWithContext(ctx, path)
		if err != nil {
			logger.LogError(err)
			return nil, GetSiteDetailsOutput{}, WrapError(err, "查询站点详情")
		}

		var result struct {
			Data interface{} `json:"data"`
		}
		if err := json.Unmarshal(data, &result); err != nil {
			logger.LogError(err)
			return nil, GetSiteDetailsOutput{}, FormatParseError("响应", err)
		}

		logger.LogSuccess("获取站点详情成功")
		return nil, GetSiteDetailsOutput{
			Site: result.Data,
		}, nil
	}
}
